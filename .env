# Database Configuration
POSTGRES_USER=honeystack_admin
POSTGRES_PASSWORD=honeystack_secure_pass_123
POSTGRES_DB=honeystack_db
DATABASE_URL=postgresql://honeystack_admin:honeystack_secure_pass_123@db:5432/honeystack_db

# Cache Configuration
REDIS_URL=redis://cache:6379/0

# Sensor Configuration
SSH_PORT=2222
HTTP_PORT=8081
SHELL_LOGIN_PERCENTAGE=0.05

# Enrichment & APIs
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
# OpenAI or Anthropic API key for weekly report generation (optional)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Campaign Detection & Archival
CAMPAIGN_THRESHOLD=3
CAMPAIGN_WINDOW_HOURS=1
DATA_RETENTION_DAYS=90

# Dashboard Configuration
DASHBOARD_PORT=3000
